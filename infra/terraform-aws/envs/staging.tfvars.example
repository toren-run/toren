# staging — small and cheap; copy to staging.tfvars and fill in
region            = "eu-central-1"
project           = "toren-staging"
image             = "<ecr-url>:<git-sha>"   # pin a tag, never :latest
agent_dir         = "examples/research-crew"
worker_count      = 1
db_instance_class = "db.t4g.micro"
# agent_env_secret_arns = { SERP_API_KEY = "arn:aws:secretsmanager:...:secret:staging/serp" }

# --- bring your own infrastructure (all optional; defaults create everything) ---
# create_vpc         = false
# vpc_id             = "vpc-0abc..."
# private_subnet_ids = ["subnet-...", "subnet-..."]
# public_subnet_ids  = ["subnet-...", "subnet-..."]   # only for create_alb = true
# create_db          = false
# database_url       = "postgres://toren:...@your-db.internal:5432/toren?sslmode=no-verify"
# create_alb         = false

# --- worker auto-scaling (optional; default is fixed worker_count) ---
# enable_autoscaling     = true
# autoscaling_min        = 1
# autoscaling_max        = 8
# autoscaling_cpu_target = 60

{
  "name": "toren-run",
  "version": "0.1.3",
  "type": "module",
  "bin": {
    "toren": "./bin/toren.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@toren-run/adapters-aws": "workspace:^",
    "@toren-run/client": "workspace:^",
    "@toren-run/core": "workspace:^",
    "@toren-run/providers": "workspace:^",
    "commander": "^12.1.0",
    "jiti": "^2.4.0",
    "yaml": "^2.5.0",
    "@toren-run/console": "workspace:^",
    "@aws-sdk/client-s3": "^3.650.0",
    "@aws-sdk/client-ecr": "^3.650.0",
    "pg": "^8.13.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0",
    "e2b": "^2.0.0"
  },
  "devDependencies": {
    "zod": "^3.23.0",
    "@types/pg": "^8.11.0",
    "@types/pdf-parse": "^1.1.4",
    "xlsx": "^0.18.5"
  },
  "description": "Toren CLI: scaffold, run, and deploy durable agents that survive anything and never re-pay a completed model call.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toren-run/toren.git",
    "directory": "packages/cli"
  },
  "homepage": "https://toren.run",
  "bugs": "https://github.com/toren-run/toren/issues",
  "keywords": [
    "agents",
    "ai",
    "durable-execution",
    "workflow",
    "postgres",
    "anthropic",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node scripts/sync-module.mjs"
  },
  "files": [
    "dist",
    "bin",
    "terraform-aws"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "peerDependencies": {
    "xlsx": "^0.18.5"
  },
  "peerDependenciesMeta": {
    "xlsx": {
      "optional": true
    }
  }
}
